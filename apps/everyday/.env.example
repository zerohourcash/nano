# ─── Общее ───────────────────────────────────────────────────────────────────
# Адрес прослушивания. Не-loopback требует MESHKEEPER_COOKIE_SECURE=1 и HTTPS
# перед узлом — иначе узел откажется стартовать.
MESHKEEPER_BIND=127.0.0.1:8080
MESHKEEPER_DB=data/meshkeeper-rs.db
MESHKEEPER_COOKIE_SECURE=0

# Имя узла в админке (по умолчанию — имя компьютера).
# MESHKEEPER_NAME=Склад-1

# ─── Синхронизация «сервер + локальные узлы» ─────────────────────────────────
# Общий секрет сервера и всех его узлов, минимум 32 символа.
# Без него обмен выключен и /sync/* отвечает 401.
# Сгенерировать: openssl rand -hex 32
# MESHKEEPER_SYNC_TOKEN=

# Роль определяется конфигурацией, отдельного переключателя нет:
#   сервер        — задан только MESHKEEPER_SYNC_TOKEN;
#   локальный узел — дополнительно задан MESHKEEPER_UPSTREAM;
#   автономный    — не задано ничего.
# MESHKEEPER_UPSTREAM=https://meshkeeper.example.com

# Только для изолированной тестовой LAN без TLS. В production не включать.
# MESHKEEPER_ALLOW_INSECURE_SYNC=0

# По умолчанию активные QR-приглашения не покидают создавший их узел.
# Включать только если все узлы находятся в одной доверенной зоне.
# MESHKEEPER_SYNC_INVITES=0

# Период обмена в секундах (5…3600). Узел работает офлайн: если сервер
# недоступен, ошибка видна в «Админка → Офлайн-узлы», попытка повторится.
# MESHKEEPER_SYNC_INTERVAL=15

# ─── Демо-режим (только для показа, не для production) ───────────────────────
# MESHKEEPER_DEMO_DATA=1
# MESHKEEPER_DEMO_LOGIN=1
# MESHKEEPER_OPEN_REGISTRATION=1

# ─── Развёртывание сервера (используется deploy/deploy.sh) ───────────────────
# Реквизиты в файлы не пишем: скрипт берёт их из окружения и ходит по SSH-ключу.
# MESHKEEPER_DEPLOY_HOST=203.0.113.10
# MESHKEEPER_DEPLOY_USER=meshkeeper

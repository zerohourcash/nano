# ─── Зависимости и сборка ───────────────────────────────────────────────────
node_modules
dist/
build/
.build/
backend/target/
*.tsbuildinfo
coverage/
.nyc_output/

# ─── Секреты ────────────────────────────────────────────────────────────────
# .env.example коммитится как шаблон, реальные значения — никогда.
.env
.env.local
.env.*.local
*.pem
*.key
*.jks
*.keystore
*.p12
*.pfx

# Локальные шаблоны для verify-artifact: в них лежат конкретные секреты
# развёртывания, поэтому сам сторож их не хранит.
scripts/leaked-patterns.local

# ─── Данные ─────────────────────────────────────────────────────────────────
data/
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
db/migrations/*.sql

# ─── Android ────────────────────────────────────────────────────────────────
android/.gradle/
android/app/build/
# Каталог собирается задачей copyWww из dist/public — в репозитории не нужен
# и вдобавок тянет за собой устаревшую копию фронтенда.
android/app/src/main/assets/www/
# Путь к SDK у каждого свой.
android/local.properties
*.apk
*.aab

# ─── Рабочие каталоги инструментов ──────────────────────────────────────────
.omc/
__pycache__/
*.pyc

# ─── Прочее ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
